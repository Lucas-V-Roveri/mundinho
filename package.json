{
  "name": "mundinho-pra-sempre",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/generate-minecraft-icons.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-minecraft-icons.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:progression": "node --experimental-strip-types --test tests/progression-suggestion.test.mjs",
    "test:bestiary-media": "node --experimental-strip-types --test tests/bestiary-media.test.mjs",
    "test:bestiary-audit": "node --test tests/bestiary-bomd-canary.test.mjs",
    "test:minecraft-progress": "node --experimental-strip-types --test tests/minecraft-progress.test.mjs",
    "verify": "npm run test:progression && npm run test:bestiary-media && npm run test:bestiary-audit && npm run test:minecraft-progress && npm run typecheck && npm run lint && npm run build",
    "sync:content": "node scripts/sync-content-snapshot.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3"
  }
}
